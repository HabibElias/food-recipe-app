# Public URLs only. Never put a Hasura admin secret or a database token here.
NUXT_PUBLIC_GRAPHQL_HTTP_ENDPOINT=http://localhost:8080/v1/graphql
NUXT_PUBLIC_GRAPHQL_WS_ENDPOINT=ws://localhost:8080/v1/graphql
# Server-side readiness check for authentication; use your Go API health URL.
NUXT_AUTH_HEALTH_ENDPOINT=http://localhost:8000/v1/healthz
